SPRING_PROFILES_ACTIVE=prod
APP_ENV=prod
SERVER_ADDRESS=127.0.0.1
SERVER_PORT=8080
SERVER_FORWARD_HEADERS_STRATEGY=native
SERVER_TOMCAT_ACCEPT_COUNT=2000
SERVER_TOMCAT_MAX_CONNECTIONS=8192
SERVER_TOMCAT_THREADS_MAX=200
SERVER_TOMCAT_THREADS_MIN_SPARE=200
ERP_NODE_ID=10
ERP_WORKER_ENABLED=false
# 启用多方式登录时，所有 API 节点共享 32 字节安全随机数的 Base64 编码。
ERP_LOGIN_SETTINGS_KEY=
# 邮箱验证码允许连接的 SMTP 主机名，以英文逗号分隔。
ERP_LOGIN_SMTP_ALLOWED_HOSTS=
DB_HOST=db.internal
DB_PORT=3306
DB_NAME=erp_prod
DB_USER=erp_runtime
DB_PASSWORD=
DB_SSL_MODE=VERIFY_IDENTITY
DB_MIGRATION_USER=erp_migration
DB_MIGRATION_PASSWORD=
# API 与 Worker 使用相同的报表备库配置，密码通过私有环境文件注入。
ERP_REPORT_JDBC_URL=jdbc:mysql://mysql-replica.internal:3306/erp?sslMode=VERIFY_IDENTITY&connectionTimeZone=UTC&forceConnectionTimeZoneToSession=true&characterEncoding=UTF-8
ERP_REPORT_DB_USER=erp_report
ERP_REPORT_DB_PASSWORD=
REDIS_HOST=redis.internal
REDIS_PORT=6379
REDIS_USERNAME=erp
REDIS_PASSWORD=
SPRING_DATA_REDIS_SSL_ENABLED=true
SPRING_DATA_REDIS_SSL_BUNDLE=redis
SPRING_SSL_BUNDLE_PEM_REDIS_TRUSTSTORE_CERTIFICATE=file:/etc/erp/client-tls/redis-ca.crt
SPRING_SSL_BUNDLE_PEM_REDIS_KEYSTORE_CERTIFICATE=file:/etc/erp/client-tls/redis-client.crt
SPRING_SSL_BUNDLE_PEM_REDIS_KEYSTORE_PRIVATEKEY=file:/etc/erp/client-tls/redis-client.key
STORAGE_ENDPOINT=https://objects.example.invalid
STORAGE_BUCKET=erp-private
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
ERP_LOG_FILE=/var/log/erp/api.log
ERP_HTTP_LOG_FILE=/var/log/erp/api-http.log
# 使用监控部署时，追加 observability 配置并按服务设置独立管理端口。
ERP_METRICS_TOKEN=
ERP_MANAGEMENT_ADDRESS=127.0.0.1
ERP_MANAGEMENT_PORT=9091
ERP_SERVICE_ROLE=api
# systemd 使用外置 Agent 时设置 JAVA_TOOL_OPTIONS=-javaagent:/opt/erp/otel/opentelemetry-javaagent.jar。
OTEL_SERVICE_NAME=qiheng-erp-api
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318
OTEL_TRACES_SAMPLER=parentbased_traceidratio
OTEL_TRACES_SAMPLER_ARG=0.1
OTEL_METRICS_EXPORTER=none
OTEL_LOGS_EXPORTER=none
OTEL_INSTRUMENTATION_JDBC_STATEMENT_SANITIZER_ENABLED=true
