# 复制到 deploy/private/ai.env 或 systemd 的 /etc/erp/ai.env，填入该环境的凭据。
# 容器覆盖 ERP_AI_BIND、ERP_AI_PORT、ERP_AI_ERP_ORIGIN 和 ERP_AI_KB_STORAGE。
ERP_AI_BIND=127.0.0.1
ERP_AI_PORT=18081
ERP_AI_ERP_ORIGIN=http://127.0.0.1:8080
ERP_AI_KB_STORAGE=/var/lib/erp-ai/knowledge
ERP_AI_DB_URL=jdbc:mysql://mysql-primary:3306/erp_ai?sslMode=VERIFY_IDENTITY&connectionTimeZone=UTC&forceConnectionTimeZoneToSession=true&characterEncoding=UTF-8
ERP_AI_DB_USER=erp_ai_runtime
ERP_AI_DB_PASSWORD=
ERP_AI_MIGRATE=true
# 首次迁移使用仅对 erp_ai 库拥有建表权限的账号，迁移完成后也可改为外部执行。
SPRING_FLYWAY_USER=erp_ai_migration
SPRING_FLYWAY_PASSWORD=
# 与 ERP API 的值一致，至少 32 字节随机值。
ERP_AI_SIGNING_KEY=
# 模型凭据加密使用独立的 32 字节随机值，以 Base64 编码。
ERP_AI_PROVIDER_KEY=
# 只列出受信任的模型来源，以英文逗号分隔多个 id=https://host/v1。
ERP_AI_PROVIDER_ENDPOINTS=
ERP_AI_ALLOW_OVERSEAS=false
ERP_AI_SEARCH_MODE=opensearch
ERP_AI_SEARCH_URL=https://opensearch:9200
ERP_AI_SEARCH_USERNAME=erp_ai
ERP_AI_SEARCH_PASSWORD=
ERP_AI_SEARCH_ANALYZER=cjk
ERP_AI_EMBEDDING_URL=
ERP_AI_EMBEDDING_TOKEN=
ERP_AI_EMBEDDING_MODEL=BAAI/bge-m3
ERP_AI_RERANK_URL=
ERP_AI_RERANK_TOKEN=
ERP_AI_RERANK_MODEL=BAAI/bge-reranker-v2-m3
ERP_AI_OCR_URL=
ERP_AI_OCR_TOKEN=
# 内网 CA 由运维导入 JVM truststore。容器可挂载到 /etc/erp-ai/tls。
# JAVA_TOOL_OPTIONS=-Djavax.net.ssl.trustStore=/etc/erp-ai/tls/truststore.p12
