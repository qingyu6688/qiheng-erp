[Unit]
Description=ERP 后台任务服务
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=erp
Group=erp
WorkingDirectory=/opt/erp/current
EnvironmentFile=/etc/erp/worker.env
Environment=SPRING_PROFILES_ACTIVE=prod
Environment=ERP_WORKER_ENABLED=true
Environment=ERP_NODE_ID=11
Environment=SERVER_PORT=8081
Environment=ERP_LOG_FILE=/var/log/erp/worker.log
ExecStart=/usr/bin/java -XX:MaxRAMPercentage=70 -jar /opt/erp/current/erp-server.jar
Restart=on-failure
RestartSec=5
TimeoutStopSec=90
SuccessExitStatus=143
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/log/erp
UMask=0027

[Install]
WantedBy=multi-user.target
