[Unit]
Description=ERP 核心业务与后台任务合并服务
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=erp
Group=erp
WorkingDirectory=/opt/erp/current
EnvironmentFile=/etc/erp/combined.env
Environment=SPRING_PROFILES_ACTIVE=prod
Environment=ERP_WORKER_ENABLED=true
Environment=ERP_NODE_ID=10
Environment=ERP_SERVICE_ROLE=combined
Environment=SERVER_TOMCAT_THREADS_MIN_SPARE=20
Environment=SERVER_TOMCAT_THREADS_MAX=100
Environment=SPRING_DATASOURCE_HIKARI_MAXIMUM_POOL_SIZE=10
Environment=ERP_LOG_FILE=/var/log/erp/combined.log
Environment=ERP_HTTP_LOG_FILE=/var/log/erp/combined-http.log
# 启动参数明确固定工作角色和连接预算，避免复制配置时继承 API-only 或大机线程值。
ExecStart=/usr/bin/java -Xms256m -Xmx1280m -jar /opt/erp/current/erp-server.jar --erp.worker.enabled=true --server.tomcat.threads.min-spare=20 --server.tomcat.threads.max=100 --spring.datasource.hikari.maximum-pool-size=10
MemoryHigh=1792M
MemoryMax=2G
Restart=on-failure
RestartSec=5
TimeoutStopSec=90
SuccessExitStatus=143
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/log/erp
UMask=0027

[Install]
WantedBy=multi-user.target
