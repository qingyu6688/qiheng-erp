# 在项目根目录复制为 .env，并按本机环境填写密码。
APP_ENV=dev
JAVA_HOME=E:\JDK21
SERVER_PORT=8080
SERVER_TOMCAT_ACCEPT_COUNT=2000
SERVER_TOMCAT_MAX_CONNECTIONS=8192
SERVER_TOMCAT_THREADS_MAX=200
SERVER_TOMCAT_THREADS_MIN_SPARE=200
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=erp_dev
DB_USER=erp_dev
DB_PASSWORD=
DB_SSL_MODE=DISABLED
# 开发与测试留空时沿用各自数据源；生产必须使用独立迁移账号。
DB_MIGRATION_USER=
DB_MIGRATION_PASSWORD=
# 本机留空时，报表与导出使用主库；配置后只走该只读连接，不自动回退。
ERP_REPORT_JDBC_URL=
ERP_REPORT_DB_USER=
ERP_REPORT_DB_PASSWORD=
TEST_DB_NAME=erp_test
TEST_DB_USER=erp_test
TEST_DB_PASSWORD=
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=
ERP_DEV_ADMIN_PASSWORD=
ERP_DEV_TENANT_CODE=DEMO
ERP_NODE_ID=0
# 需要启用多方式登录时，填入 32 字节安全随机数的 Base64 编码。
ERP_LOGIN_SETTINGS_KEY=
# 邮箱验证码允许连接的 SMTP 主机名，以英文逗号分隔。
ERP_LOGIN_SMTP_ALLOWED_HOSTS=
# 请求日志独立写入轮转文件；业务审计仍同步保存在数据库。
ERP_HTTP_LOG_FILE=./logs/http.log
# 启用 observability 配置时使用独立监控凭据和管理端口。
ERP_METRICS_TOKEN=
ERP_MANAGEMENT_PORT=9091
# 附件与可选的外置链路采集地址。
STORAGE_ENDPOINT=
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
OTEL_EXPORTER_OTLP_ENDPOINT=

# 默认仅允许同源 WebSocket；有独立前端站点时用英文逗号列出完整 Origin，禁止通配符。
ERP_WEBSOCKET_ALLOWED_ORIGINS=
