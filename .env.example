# 在项目根目录复制为 .env，并按本机环境填写密码。
APP_ENV=dev
JAVA_HOME=E:\JDK21
SERVER_PORT=8080
SERVER_TOMCAT_ACCEPT_COUNT=2000
SERVER_TOMCAT_MAX_CONNECTIONS=8192
SERVER_TOMCAT_THREADS_MAX=200
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=erp_dev
DB_USER=erp_dev
DB_PASSWORD=
DB_SSL_MODE=DISABLED
# 开发与测试留空时沿用各自数据源；生产必须使用独立迁移账号。
DB_MIGRATION_USER=
DB_MIGRATION_PASSWORD=
TEST_DB_NAME=erp_test
TEST_DB_USER=erp_test
TEST_DB_PASSWORD=
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=
ERP_DEV_ADMIN_PASSWORD=
ERP_DEV_TENANT_CODE=DEMO
ERP_NODE_ID=0
# 附件和追踪在对应里程碑接入时配置。
STORAGE_ENDPOINT=
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
OTEL_EXPORTER_OTLP_ENDPOINT=
